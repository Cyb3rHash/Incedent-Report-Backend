# Required
# Postgres SQLAlchemy URL (async). Example for Neon (TLS required):
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Optional
# Comma-separated list for CORS, e.g. http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=

# Optional logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional server binding (used by script.sh; uvicorn defaults also work)
HOST=0.0.0.0
PORT=3002
